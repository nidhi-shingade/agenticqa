# Copy to .env (git-ignored) and fill in values from your team's secret store.
# Do not commit real values, tokens, or connection strings.

# Environment under test (non-production only).
QA_BASE_URL=https://staging.example.com

# Ticket being tested. Set by the skill at run time; used to name report folders.
AGENTICQA_TICKET=PROJ-123

# Set to 1 to see the desktop browser while tests run.
AGENTICQA_HEADED=0

# Test account for the flows under test. Read by tests/support/env.ts.
QA_TEST_USER=
QA_TEST_PASSWORD=
